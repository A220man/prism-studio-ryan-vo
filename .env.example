# Database
DATABASE_URL=sqlite+aiosqlite:///./data/prism.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM (optional - for edge explanations)
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Keycloak (optional - for authentication)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=prism-studio
KEYCLOAK_CLIENT_ID=prism-frontend
KEYCLOAK_CLIENT_SECRET=dev-secret-change-in-production